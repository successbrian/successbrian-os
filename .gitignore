# marketer watch: transcripts are working data, refetched on demand
tools/marketer_watch_transcripts/

# altair routines: state.db is runtime state on k11, never committed
tools/altair_routines/state.db

# runtime state / snapshots: rewritten by the tools on every run, go stale in git
tools/automate/state/
tools/state/
tools/staging/
tools/marketer_watch.db
*.db

# crypto-intel: API response caches are refetched on demand
tools/crypto-intel/.cache/

# compiled python is build output, regenerated on demand
__pycache__/
*.py[cod]

# venture toolkit: per-user stream config is personal, never committed
tools/ventures/user_streams.json
