    body = (
        "--%s\r\nContent-Disposition: form-data; name=\"file\"; "
        "filename=\"%s\"\r\nContent-Type: text/markdown\r\n\r\n"
        "%s\r\n--%s--\r\n" % (boundary, fname, text, boundary)
    ).encode()
    req = urllib.request.Request(
