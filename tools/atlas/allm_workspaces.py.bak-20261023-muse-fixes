    lines = audit(conn)
    joined = "\n".join(lines)
    check("not yet created" not in joined,
          "audit: no determined-but-uncreated workspaces remain "
          "(all ruled workspaces are live since 2026-10-22)")
    check("mountain-north" in joined,
          "audit catches the mountain-north name drift")
    check("atlas-keystones" in joined,
