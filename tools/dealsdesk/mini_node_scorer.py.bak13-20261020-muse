#!/usr/bin/env python3
"""mini_node_scorer.py — rank used DDR4 business desktops as fleet nodes.

PURPOSE: Score and rank used business-desktop listings (ThinkCentre,
         EliteDesk/ProDesk, OptiPlex — 1L Tiny/Mini/Micro and their SFF
         and tower siblings) against Brian's
         2026-10-20 sourcing directive: cheap DDR4 nodes that run the
         DeepSeek V4 Flash REAP 150B under Colibri as background/contributing
         inference lanes. Raw speed is NOT the goal — running it at all is.

WHY:     Colibri's floor for the REAP is 16 GB RAM with experts streamed
         from NVMe, so a $199-class DDR4 box qualifies — but only if the
         exact machine is right. The traps are silent: Celeron/Pentium CPUs
         with no AVX2, soldered RAM, single SO-DIMM slots, M.2 slots wired
         x2, and no path past gigabit networking. And under the 2026 RAM
         price regime the RAM already inside the deal can be worth more
         than the box, so installed RAM is valued in dollars, not just GB.
         Companion to rack_server_scorer.py (which encodes the separate
         2026-10-08 rack directive; its 64 GB floor does NOT apply here).

CALLED BY: DealsDesk agent when the DDR4 fleet hunt returns candidates;
         manually for one-off listing checks. This module ranks only; it
         never purchases anything.

NOTES:   - Prices/valuations come from ram_price_reference.json in this
           directory (verified 2026-10-20) when present; embedded fallbacks
           match that file. Re-verify prices before relying on them.
         - Upgradeability is scored by Brian's rule: its weight scales with
           the moving price of RAM. factor = historical_norm_$/GB divided
           by current used $/GB, clamped 0..1 — expensive RAM makes empty
           slots worth less, cheap RAM makes them worth more.
    - CANONICAL SOURCE: successbrian-os/tools/dealsdesk/mini_node_scorer.py
"""

import argparse
import json
import logging
import os
import sys

logging.basicConfig(level=logging.INFO, format="%(message)s")
LOG = logging.getLogger("mini_node_scorer")

# The trap registry (same directory) is the single source of truth for
# banned hardware. The local CPU_BURNOUT_RE below is only a fallback for
# deployments where the registry module is missing.
try:
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    import hardware_traps as _traps
except Exception:
    _traps = None

# --- Directive constants (Brian 2026-10-20) -----------------------------------
# Delivered-price caps are per form factor (Brian 2026-10-20): the $199
# ceiling was sized for 1L mini/micro; an SFF delivers native PCIe, 4 DIMM
# slots and drive bays, a tower adds full-height slots and a real PSU, so
# each class gets its own level.
PRICE_CAPS_USD = {"1l": 199.0, "sff": 249.0, "tower": 299.0}
# Tower GPU-host doctrine (Brian 2026-10-20): towers host V100-class and
# other 24GB+ GPUs, power-capped ("toned down") to about 150W, on a true
# PCIe Gen3+ x16 slot. PSU floor leaves headroom over GPU + CPU + platform.
GPU_POWER_CAP_W = 150
GPU_MIN_VRAM_GB = 24
TOWER_MIN_PSU_W = 400
COLIBRI_RAM_FLOOR_GB = 16     # REAP 150B starts here per the Colibri catalog
STORAGE_FLOOR_GB = 256        # parts floor + pull threshold: an included
                              # NVMe under this is a $0 pull part, not a
                              # machine rejection (owner ruling 2026-10-20)

# CPU strings that mean "no AVX2, no deal" (the cheap-bin traps).
CPU_BLOCKLIST = ("celeron", "pentium", "j4125", "j4105", "j4025", "j6412",
                 "n5095", "n5105", "n3450", "n3350")

# Intel 13th/14th-gen (Raptor Lake) desktop CPUs: the Vmin-degradation /
# burn-out class. Brian 2026-10-20: "we are NOT looking for any of the
# intel cpus that potentially will burn themselves out." Model numbers
# 13xxx / 14xxx in a Core name, or an explicit Raptor Lake mention.
# Scope is the documented failure mechanism, not the brand: Core Ultra /
# Arrow Lake is a different design with no such finding and is NOT banned.
# Widen only on evidence. Rationale: docs/HARDWARE-TRAPS.md; agent
# contract rule 12; same gate in dealsdesk/src/validation_gates.py.
import re as _re
CPU_BURNOUT_RE = _re.compile(r"\b1[34]\d{3}[a-z]*\b|raptor", _re.IGNORECASE)
# CPU strings known to carry AVX2.
# ISA check (verified 2026-10-20 against Colibri's repo docs): the engine
# is portable C with "no x86-only intrinsics" (docs/quickstart.md), builds
# ARCH=native, and its setup detects/reports AVX2 and AVX_VNNI. The fast
# CPU baseline is AVX2 + FMA + F16C — present on EVERY best-tier chip
# below. None of the DDR4-class chips have AVX-512 or VNNI (Comet Lake
# included); VNNI is a speed bonus where present, never a requirement —
# Colibri's own published CPU measurement for the full V4 Flash
# (0.93 tok/s @ 32GB) was taken on a Ryzen 7 5800X, an AVX2-only chip.
CPU_AVX2_KNOWN = ("core i3", "core i5", "core i7", "core i9", "ryzen",
                  "n100", "n95", "n97", "core 3", "core 5", "core 7")

# Best-in-class CPUs only (Brian 2026-10-20: "we are interested in only
# the best cpu's"). For the DDR4 hunt platforms that means the top tier of
# each generation — the fleet waits for these instead of settling:
#   Intel 8th gen: i7-8700/8700T/8700K (6C/12T)
#   Intel 9th gen: i7-9700/9700T (8C), i9-9900/9900T/9900K (8C/16T)
#   Intel 10th gen: i7-10700/10700T and up
#   AMD DDR4 era: Ryzen 7 / Ryzen 9 class
# An i5 is a fine chip and a settled-for node. Not here.
BEST_CPU_PATTERNS = [
    r"i7-87\d{2}", r"i7-97\d{2}", r"i9-99\d{2}",
    r"i7-107\d{2}", r"i9-109\d{2}",
    r"ryzen\s*[79]\b", r"ryzen\s*[79]\s*pro",
]
_BEST_CPU_RE = _re.compile("|".join(BEST_CPU_PATTERNS), _re.IGNORECASE)


def best_cpu_ok(c):
    """True if the CPU is in the best-in-class tier for its generation.
    An explicit best_cpu field wins; otherwise the model string decides."""
    if c.get("best_cpu") is not None:
        return bool(c["best_cpu"])
    return bool(_BEST_CPU_RE.search(str(c.get("cpu", ""))))

# Fallbacks matching ram_price_reference.json (verified 2026-10-20).
# 8GB tier is $0 by owner ruling: "8GB ram sticks are $0 to us."
_FALLBACK_RAM_VALUE = {8: 0, 16: 55, 32: 130, 64: 365}   # used-market mids
_FALLBACK_GB_PRICE = 5.7        # current used DDR4 $/GB
_FALLBACK_NORM_GB_PRICE = 2.0   # 2023-24 norm $/GB


def _load_price_reference():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "ram_price_reference.json")
    try:
        with open(path) as f:
            ref = json.load(f)
        val = ref["valuation_for_scorers"]
        ram_value = {int(k): v for k, v in
                     val["ddr4_installed_ram_value_usd"].items()}
        return (ram_value, float(val["ddr4_used_gb_price_usd"]),
                float(val["historical_norm_gb_price_usd"]))
    except Exception:
        return _FALLBACK_RAM_VALUE, _FALLBACK_GB_PRICE, _FALLBACK_NORM_GB_PRICE


RAM_VALUE_USD, GB_PRICE_USD, NORM_GB_PRICE_USD = _load_price_reference()


def ram_value_usd(ram_gb):
    """Used-market value of the installed DDR4, nearest tier at/below."""
    tiers = sorted(RAM_VALUE_USD)
    best = 0
    for t in tiers:
        if ram_gb >= t:
            best = RAM_VALUE_USD[t]
    return best


def upgradeability_factor():
    """Brian's rule: expensive RAM shrinks the value of upgradeability."""
    if GB_PRICE_USD <= 0:
        return 1.0
    return max(0.0, min(1.0, NORM_GB_PRICE_USD / GB_PRICE_USD))


def avx2_ok(c):
    """Returns (ok, known). Explicit avx2 field wins; then blocklist/known."""
    if c.get("avx2") is not None:
        return bool(c["avx2"]), True
    cpu = str(c.get("cpu", "")).lower()
    if any(b in cpu for b in CPU_BLOCKLIST):
        return False, True
    if any(k in cpu for k in CPU_AVX2_KNOWN):
        return True, True
    return False, False


# Reference target for --bar: the shape of deal the directive hunts.
REFERENCE_BAR = {
    "name": "ThinkCentre M920q i7-8700T 32GB (reference target)",
    "price": 179.0, "shipping": 12.0,
    "cpu": "Intel Core i7-8700T", "cores": 6,
    "ram_gb": 32, "sodimm_slots": 2, "soldered": False, "ram_ceiling_gb": 64,
    "nvme_slots": 1, "nvme_lanes": 4, "storage_gb": 256, "sata_bay": False,
    "ethernet_gbe": 1.0, "wifi_slot": True, "pcie_riser": True,
    "usb32_gen2": True, "power_adapter": True,
}


def score_candidate(c):
    """Score one candidate dict. Returns the dict with scoring fields added."""
    price = float(c.get("price", 0) or 0)
    shipping = float(c.get("shipping", 0) or 0)
    delivered = price + shipping
    ram_gb = int(c.get("ram_gb", 0) or 0)
    cores = int(c.get("cores", 0) or 0)
    ceiling = int(c.get("ram_ceiling_gb", 0) or 0)
    notes = []
    rejects = []

    c["delivered_usd"] = round(delivered, 2)
    c["ram_value_usd"] = ram_value_usd(ram_gb)
    c["net_cost_after_ram_credit_usd"] = round(delivered - c["ram_value_usd"], 2)
    c["upgradeability_factor"] = round(upgradeability_factor(), 2)
    # Pull parts: included parts worth $0 to us because they will be
    # pulled and upgraded (owner ruling 2026-10-20). Reported, so a deal
    # is never credited for them; they never reject the machine either.
    pull_parts = []
    if 0 < ram_gb <= 8:
        pull_parts.append("%dGB RAM — $0, pulled and upgraded" % ram_gb)
    storage_gb_pre = int(c.get("storage_gb", 0) or 0)
    if 0 < storage_gb_pre < STORAGE_FLOOR_GB:
        pull_parts.append("%dGB NVMe — $0, pulled for a 256/512GB drive"
                          % storage_gb_pre)
    c["pull_parts"] = pull_parts

    # --- Hard gates (fail any = out) -----------------------------------------
    ff_key = str(c.get("form_factor", "1l")).lower()
    price_cap = PRICE_CAPS_USD.get(ff_key, PRICE_CAPS_USD["1l"])
    if delivered > price_cap:
        rejects.append("delivered $%.2f over the $%d cap for %s machines"
                       % (delivered, price_cap, ff_key.upper()))
    ok, known = avx2_ok(c)
    if not ok:
        rejects.append("no AVX2 (Colibri needs it)"
                       if known else "CPU unknown — AVX2 unverified")
    if ok and not best_cpu_ok(c):
        rejects.append("CPU is not best-in-class for its generation — "
                       "the fleet takes only the best CPUs (i7-8700 / "
                       "i7-9700 / i9-9900 class and up)")
    cpu_text = str(c.get("cpu", ""))
    trap_hit = (_traps.check_item(cpu_text, kind="cpu")
                if _traps is not None else None)
    if trap_hit is not None or CPU_BURNOUT_RE.search(cpu_text):
        rejects.append("Intel 13th/14th-gen (Raptor Lake) — the "
                       "degradation/burn-out class; excluded by directive")
    if c.get("soldered"):
        rejects.append("RAM soldered")
    ram_slots = int(c.get("dimm_slots", 0) or c.get("sodimm_slots", 0) or 0)
    if ram_slots < 2:
        rejects.append("fewer than 2 RAM slots")
    if ceiling < 32:
        rejects.append("RAM ceiling %dGB — no path to 32GB+" % ceiling)
    if int(c.get("nvme_slots", 0) or 0) < 1:
        rejects.append("no M.2 NVMe slot")
    storage_gb = int(c.get("storage_gb", 0) or 0)
    # An undersized included NVMe is NOT a rejection (owner ruling
    # 2026-10-20): a 128GB drive is worth $0 to us because it will be
    # pulled for a 256/512GB drive — same accounting as 8GB RAM sticks.
    # It is recorded in pull_parts and earns no storage bonus. (Buying
    # small NVMe PARTS is still floored out — see sourcing_floors.py.)
    if not c.get("ethernet_gbe"):
        rejects.append("no Ethernet")
    if cores and cores < 4:
        rejects.append("fewer than 4 cores (streaming is CPU-bound)")

    # --- Tower doctrine: REALLY strict (Brian 2026-10-20) -------------------
    # A tower's job in this fleet is hosting big GPUs: V100-class cards and
    # other 24GB+ GPUs (V100 32GB, P40 24GB, M40 24GB, 3090-class), run
    # power-capped around 150W. A tower that cannot host one has no job
    # here — the 1L/SFF classes already cover CPU-only nodes.
    if ff_key == "tower":
        if not (int(c.get("pcie_gen", 0) or 0) >= 3
                and c.get("pcie_x16_electrical")):
            rejects.append("tower lacks a true PCIe Gen3+ x16 slot "
                           "(x16 electrical) — the GPU class we run is "
                           "PCIe-generation-sensitive; an x16-shaped x4 "
                           "slot does not count")
        psu_w = int(c.get("psu_watts", 0) or 0)
        if psu_w < TOWER_MIN_PSU_W:
            rejects.append("tower PSU %dW under the %dW floor — a %dW-capped "
                           "GPU plus a full-power CPU needs headroom"
                           % (psu_w, TOWER_MIN_PSU_W, GPU_POWER_CAP_W))
        if not c.get("gpu_power_leads"):
            rejects.append("tower PSU has no GPU power lead (8-pin PCIe/EPS) "
                           "for a V100-class card")
        if not c.get("gpu_dual_slot_ok"):
            rejects.append("tower cannot physically fit a full-height "
                           "dual-slot GPU")

    if rejects:
        c["score"] = -1.0
        c["verdict"] = "REJECT"
        c["notes"] = rejects
        return c

    # --- Scored factors, Brian's priority order ------------------------------
    score = 40.0

    # 1. Installed RAM (the deal's real payload under 2026 prices).
    if ram_gb >= 64:
        score += 30
    elif ram_gb >= 32:
        score += 22
    elif ram_gb >= COLIBRI_RAM_FLOOR_GB:
        score += 10
        notes.append("16GB: runs the REAP today at the Colibri floor, and "
                     "the stick itself is a keeper — part of this "
                     "machine's value (owner ruling 2026-10-20)")
    elif 0 < ram_gb <= 8:
        notes.append("8GB as shipped: worth $0 to us — the sticks will be "
                     "pulled and upgraded; the machine is judged on its "
                     "platform, not its RAM")
    elif ram_gb == 0:
        notes.append("RAM size unverified — 16GB is the Colibri floor")
    else:
        notes.append("below the 16GB Colibri floor as shipped — "
                     "needs a RAM add before it contributes")

    # 2. NVMe combo: full-x4 wiring beats slot count.
    lanes = c.get("nvme_lanes")
    if lanes == 4:
        score += 15
    elif lanes == 2:
        score += 5
        notes.append("NVMe wired x2 — streaming tier runs at half width")
    else:
        notes.append("NVMe lane width unverified — confirm before buying")
    if int(c.get("nvme_slots", 0) or 0) >= 2:
        score += 5
    if storage_gb >= 1024:
        score += 18
        notes.append("1TB+ NVMe: the whole working set lives locally "
                     "(REAP 85GB + Sonic 23GB + Flash-Next ~186GB); the "
                     "fabric becomes a booster, not a lifeline")
    elif storage_gb >= 512:
        score += 10
        notes.append("512GB NVMe: REAP plus a real local library — much "
                     "more desired (Brian 2026-10-20)")
    elif storage_gb == 0:
        notes.append("storage size unverified — floor is %dGB"
                     % STORAGE_FLOOR_GB)
    elif storage_gb < STORAGE_FLOOR_GB:
        notes.append("%dGB NVMe worth $0 to us — it will be pulled for a "
                     "256/512GB drive; earns no storage bonus" % storage_gb)
    if c.get("sata_bay"):
        score += 5
        notes.append("2.5in bay: OS/library overflow, NVMe stays pure "
                     "for expert streaming")
    bays35 = int(c.get("drive_bays_35", 0) or 0)
    if bays35 >= 1:
        score += min(10, 5 * bays35)
        notes.append("3.5in bay(s) x%d: bulk HDD library inside the node "
                     "itself (1TB+ floor, larger desired)" % bays35)

    # 3. Network upgrade paths (fabric future).
    if int(c.get("pcie_slots", 0) or 0) >= 1:
        score += 15
        notes.append("native PCIe slot(s): a real 10GbE NIC drops in — "
                     "best fabric path, no riser needed")
    elif c.get("pcie_riser"):
        score += 15
        notes.append("PCIe riser: a real 10GbE NIC fits — best fabric path")
    if c.get("wifi_slot"):
        score += 8
        notes.append("Wi-Fi M.2 slot can become a 2.5GbE port "
                     "(dual wired fabric)")
    if float(c.get("ethernet_gbe", 0) or 0) >= 2.5:
        score += 8
    if c.get("usb32_gen2"):
        score += 4
        notes.append("USB 3.2 Gen2 present: USB-10GbE fallback path")

    # 4. Fleet manners.
    if cores >= 6:
        score += 8
    elif cores >= 4:
        score += 4
    if c.get("power_adapter") is False:
        score -= 5
        notes.append("no power adapter in the deal — replacement eats "
                     "the margin")
    if c.get("wol") or c.get("auto_power_on"):
        score += 3

    # 5. Upgradeability headroom is REPORTED, not scored. Brian 2026-10-20:
    # "we just reject factoring in the cost of the ram" — machines are kept
    # on their platform merits; the price of future RAM is not part of a
    # machine's score. (The factor itself stays visible for planning.)
    headroom = max(0, ceiling - ram_gb)
    if headroom > 0:
        notes.append("headroom %dGB (upgradeability factor %.2f at used "
                     "DDR4 $%.2f/GB vs $%.2f norm — reported, not scored)"
                     % (headroom, upgradeability_factor(),
                        GB_PRICE_USD, NORM_GB_PRICE_USD))
    if ceiling == 32:
        notes.append("32GB-capped model — fine today, no cache-rich endgame")

    ff = str(c.get("form_factor", "1l")).lower()
    if ff in ("sff", "tower"):
        notes.append("%s form factor: native slots, drive bays and "
                     "4-DIMM headroom over the 1L minis, at higher idle "
                     "draw — a worthy trade for fabric nodes (Brian "
                     "2026-10-20)" % ff.upper())

    c["score"] = round(score, 1)
    c["verdict"] = ("FLEET-NODE-STRONG" if score >= 75 else
                    "FLEET-NODE" if score >= 55 else "MARGINAL")
    c["notes"] = notes
    return c


def rank(candidates):
    scored = [score_candidate(dict(c)) for c in candidates]
    scored.sort(key=lambda c: c["score"], reverse=True)
    return scored


def main(argv=None):
    ap = argparse.ArgumentParser(
        description="Rank used 1L DDR4 mini-PCs as Colibri fleet nodes.")
    ap.add_argument("--json", help="JSON file with a list of candidate dicts")
    ap.add_argument("--bar", action="store_true",
                    help="Score the reference target and exit")
    args = ap.parse_args(argv)

    if args.bar:
        print(json.dumps(score_candidate(dict(REFERENCE_BAR)), indent=2))
        return 0

    if not args.json:
        ap.error("--json <file> or --bar is required")

    with open(args.json) as f:
        candidates = json.load(f)
    ranked = rank(candidates)
    for c in ranked:
        LOG.info("%-42s score=%6.1f delivered=$%s ram_value=$%s verdict=%s",
                 c.get("name", "?")[:42], c["score"], c["delivered_usd"],
                 c["ram_value_usd"], c["verdict"])
    print(json.dumps(ranked, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
