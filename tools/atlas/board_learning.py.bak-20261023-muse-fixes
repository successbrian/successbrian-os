#!/usr/bin/env python3
"""Board Learning — the suggestion ledger (R36).

Brian (2026-10-23): "the board must learn how to make
better and better suggestions over time."

A board that dissolves every morning has no memory
unless somebody writes it down. This ledger is that
memory. Every suggestion is a tracked claim with a
life cycle:

  SUGGESTED  — seat, Atlas item, the suggestion, the
               gate score the chair-heuristic gave it
  DECIDED    — what Meghan / Altair did with it
               (R35: they decide): accepted, modified,
               rejected — with notes
  OUTCOME    — what actually happened: worked, failed,
               mixed — with notes

The scorecard turns the ledger into calibration:
per seat — how many suggestions, the acceptance rate,
the outcome hit rate, and whether the seat's gate
scores mean anything (if its rejected suggestions
score as high as its accepted ones, the seat is
miscalibrated and the brief says so).

The brief command renders the learning section for
the next session: per-seat calibration lines, the
open loops (decided but never outcome-checked — the
board's homework), and the most recent outcomes.
Learning without outcome checks is repetition; the
open-loops list exists so outcomes get recorded.

The harness integration (the session worker logging
each suggestion as it is made) is the fill path; this
CLI is the ledger, the scorecard, and the brief —
usable by hand and by the executives today.

R37 — THE 95% RELEASE LINE (Brian, 2026-10-23): "the
board only releases what it is 95% certain of. For
things it is 94.9999% or less certain of, it records
separately (a board idea table)... and issues research
orders to find out ways it can increase the surety."
So the ledger above holds RELEASES only — its schema
refuses a scored release under 0.95. Below the line
lives atlas.board_ideas, worked by research orders
(atlas.board_research_orders, executed as Atlas
tasks) until an idea crosses the line (promote) or
the research kills it (kill, with the why). The board
also works four standing improvement fronts — future
capability, ecosystem efficiency, token burn, energy
burn within budget — and the brief names any front
with no open research as a coverage gap.
"""

import subprocess

import os
import sys

import psycopg2

DBNAME = "ecosystem_central"
BRIEF_PATH = os.path.join(
    os.path.dirname(os.path.abspath(__file__)),
    "board-learning-brief.md")

DDL = """
CREATE TABLE IF NOT EXISTS atlas.board_suggestions (
    id            serial PRIMARY KEY,
    item_key      text NOT NULL,
    seat          text NOT NULL,
    suggestion    text NOT NULL,
    gate_score    numeric(4,2),
    session_ref   text,
    exec_decision text NOT NULL DEFAULT 'pending'
                  CHECK (exec_decision IN ('pending',
                         'accepted','modified','rejected')),
    exec_notes    text,
    outcome       text NOT NULL DEFAULT 'unknown'
                  CHECK (outcome IN ('unknown','worked',
                         'failed','mixed')),
    outcome_notes text,
    suggested_at  timestamptz NOT NULL DEFAULT now(),
    decided_at    timestamptz,
    outcome_at    timestamptz
);
CREATE TABLE IF NOT EXISTS atlas.board_ideas (
    id            serial PRIMARY KEY,
    item_key      text,
    seat          text NOT NULL,
    idea          text NOT NULL,
    certainty     numeric(6,4) NOT NULL,
    front         text,
    status        text NOT NULL DEFAULT 'researching'
                  CHECK (status IN ('researching',
                         'released','dead')),
    status_why    text,
    created_at    timestamptz NOT NULL DEFAULT now(),
    updated_at    timestamptz NOT NULL DEFAULT now()
);
CREATE TABLE IF NOT EXISTS atlas.board_research_orders (
    id            serial PRIMARY KEY,
    idea_id       integer REFERENCES atlas.board_ideas(id),
    front         text,
    question      text NOT NULL,
    task_key      text,
    status        text NOT NULL DEFAULT 'open'
                  CHECK (status IN ('open','answered',
                         'closed')),
    findings      text,
    created_at    timestamptz NOT NULL DEFAULT now(),
    answered_at   timestamptz
);
"""

RELEASE_THRESHOLD = 0.95

# The board's standing research beats (Brian, 2026-10-23).
IMPROVEMENT_FRONTS = {
    "future-better": "Ways we can get better in the "
                     "future — capabilities, skills, "
                     "and options we do not have yet.",
    "ecosystem-efficiency": "Ways the ecosystem itself "
                            "runs tighter — fewer steps, "
                            "fewer handoffs, less waiting.",
    "token-burn": "Ways to do the same work better "
                  "while burning fewer tokens — "
                  "routing, context discipline, model "
                  "choice.",
    "energy-burn": "Ways to burn less energy while "
                   "keeping the budget — the fleet's "
                   "power is a cost line, not a free "
                   "good.",
}

DECISIONS = ("accepted", "modified", "rejected")
OUTCOMES = ("worked", "failed", "mixed")


def pg():
    return psycopg2.connect(dbname=DBNAME, host="localhost",
                            user="postgres", password="postgres")


def ensure(conn):
    with conn.cursor() as cur:
        cur.execute(DDL)
        # R37: the release line, enforced by the schema
        # itself — a scored release under 0.95 cannot be
        # written to the suggestions ledger.
        cur.execute(
            "SELECT 1 FROM pg_constraint WHERE conname "
            "= 'board_suggestions_release_gate'")
        if not cur.fetchone():
            cur.execute(
                "ALTER TABLE atlas.board_suggestions "
                "ADD CONSTRAINT "
                "board_suggestions_release_gate CHECK "
                "(gate_score IS NULL OR gate_score >= "
                "0.95)")
    conn.commit()


def log_suggestion(conn, item_key, seat, suggestion,
                   gate_score=None, session_ref=None):
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO atlas.board_suggestions "
            "(item_key, seat, suggestion, gate_score, "
            "session_ref) VALUES (%s, %s, %s, %s, %s) "
            "RETURNING id",
            (item_key, seat, suggestion, gate_score,
             session_ref))
        sid = cur.fetchone()[0]
    conn.commit()
    return sid


def decide(conn, sid, decision, notes=""):
    if decision not in DECISIONS:
        return False
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE atlas.board_suggestions SET "
            "exec_decision = %s, exec_notes = %s, "
            "decided_at = now() WHERE id = %s",
            (decision, notes, sid))
        hit = cur.rowcount
    conn.commit()
    return bool(hit)


def set_outcome(conn, sid, outcome, notes=""):
    if outcome not in OUTCOMES:
        return False
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE atlas.board_suggestions SET "
            "outcome = %s, outcome_notes = %s, "
            "outcome_at = now() WHERE id = %s",
            (outcome, notes, sid))
        hit = cur.rowcount
    conn.commit()
    return bool(hit)


def log_idea(conn, seat, idea, certainty, item_key=None,
             front=None):
    """A sub-0.95 thought goes to the idea table —
    never to the releases ledger."""
    if certainty >= RELEASE_THRESHOLD:
        raise ValueError(
            "certainty %.4f is at/above the release line "
            "— that is a release, log it as a suggestion"
            % certainty)
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO atlas.board_ideas "
            "(item_key, seat, idea, certainty, front) "
            "VALUES (%s, %s, %s, %s, %s) RETURNING id",
            (item_key, seat, idea, certainty, front))
        iid = cur.fetchone()[0]
    conn.commit()
    return iid


def file_research_task(idea_id, front, question):
    """A research order executes as an Atlas task —
    the fleet's work queue is where research lives."""
    key = "task:board-research:%s" % (
        ("idea-%d" % idea_id) if idea_id else front)
    title = ("BOARD RESEARCH ORDER%s: %s — report "
             "findings against %s; the goal is raising "
             "certainty toward the 95%% release line "
             "(R37)."
             % ((" (idea #%d)" % idea_id) if idea_id
                else " (%s)" % front, question,
                ("board idea #%d" % idea_id) if idea_id
                else "the %s front" % front))
    here = os.path.dirname(os.path.abspath(__file__))
    proc = subprocess.run(
        [sys.executable, os.path.join(here, "atlas.py"),
         "task-add", key, title,
         "--found-by", "board-research"],
        capture_output=True, text=True, timeout=60)
    if proc.returncode != 0:
        raise RuntimeError("atlas task-add failed: %s"
                           % proc.stderr.strip())
    return key


def research_order(conn, question, idea_id=None,
                   front=None):
    ensure(conn)
    key = file_research_task(idea_id, front, question)
    with conn.cursor() as cur:
        cur.execute(
            "INSERT INTO atlas.board_research_orders "
            "(idea_id, front, question, task_key) VALUES "
            "(%s, %s, %s, %s) RETURNING id",
            (idea_id, front, question, key))
        oid = cur.fetchone()[0]
    conn.commit()
    return oid, key


def promote_idea(conn, idea_id, new_certainty,
                 session_ref=None):
    """Crossing the line: the idea becomes a release in
    the suggestions ledger. Refused below 0.95."""
    if new_certainty < RELEASE_THRESHOLD:
        return None, ("certainty %.4f is below the 95%% "
                      "release line — keep researching"
                      % new_certainty)
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "SELECT item_key, seat, idea FROM "
            "atlas.board_ideas WHERE id = %s AND "
            "status = 'researching'", (idea_id,))
        row = cur.fetchone()
        if not row:
            return None, "no researching idea #%d" \
                % idea_id
        cur.execute(
            "UPDATE atlas.board_ideas SET certainty = "
            "%s, status = 'released', updated_at = now() "
            "WHERE id = %s", (new_certainty, idea_id))
    conn.commit()
    sid = log_suggestion(conn, row[0] or "board-idea",
                         row[1], row[2],
                         gate_score=new_certainty,
                         session_ref=session_ref)
    return sid, "idea #%d released as suggestion #%d" \
        % (idea_id, sid)


def kill_idea(conn, idea_id, why):
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "UPDATE atlas.board_ideas SET status = "
            "'dead', status_why = %s, updated_at = now() "
            "WHERE id = %s AND status = 'researching'",
            (why, idea_id))
        hit = cur.rowcount
    conn.commit()
    return bool(hit)


def seat_stats(rows):
    """rows: dicts for ONE seat. Pure calibration math."""
    n = len(rows)
    decided = [r for r in rows
               if r["exec_decision"] != "pending"]
    acc = sum(1 for r in decided
              if r["exec_decision"] == "accepted")
    mod = sum(1 for r in decided
              if r["exec_decision"] == "modified")
    rej = sum(1 for r in decided
              if r["exec_decision"] == "rejected")
    acceptance = None
    if decided:
        acceptance = (acc + 0.5 * mod) / len(decided)
    outc = [r for r in rows if r["outcome"] != "unknown"]
    hit = None
    if outc:
        hit = (sum(1 for r in outc
                   if r["outcome"] == "worked")
               + 0.5 * sum(1 for r in outc
                           if r["outcome"] == "mixed")) \
            / len(outc)
    scored_acc = [float(r["gate_score"]) for r in decided
                  if r["exec_decision"] == "accepted"
                  and r["gate_score"] is not None]
    scored_rej = [float(r["gate_score"]) for r in decided
                  if r["exec_decision"] == "rejected"
                  and r["gate_score"] is not None]
    miscalibrated = bool(
        scored_acc and scored_rej
        and (sum(scored_rej) / len(scored_rej))
        >= (sum(scored_acc) / len(scored_acc)))
    return {"n": n, "decided": len(decided),
            "accepted": acc, "modified": mod,
            "rejected": rej, "acceptance": acceptance,
            "outcomes": len(outc), "hit": hit,
            "miscalibrated": miscalibrated}


def fetch_all(conn):
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, item_key, seat, suggestion, "
            "gate_score, exec_decision, outcome FROM "
            "atlas.board_suggestions ORDER BY seat, id")
        cols = ["id", "item_key", "seat", "suggestion",
                "gate_score", "exec_decision", "outcome"]
        return [dict(zip(cols, r)) for r in cur.fetchall()]


def scorecard(conn):
    rows = fetch_all(conn)
    seats = {}
    for r in rows:
        seats.setdefault(r["seat"], []).append(r)
    lines = ["# Board scorecard — is it learning?", ""]
    if not seats:
        lines.append("No suggestions in the ledger yet. "
                     "The board cannot learn from a blank "
                     "page — the ledger fills as sessions "
                     "log their suggestions.")
        return "\n".join(lines)
    for seat in sorted(seats):
        st = seat_stats(seats[seat])
        line = ("- %s: %d suggested, %d decided"
                % (seat, st["n"], st["decided"]))
        if st["acceptance"] is not None:
            line += (", acceptance %.0f%% (%d acc / %d "
                     "mod / %d rej)"
                     % (100 * st["acceptance"], st["accepted"],
                        st["modified"], st["rejected"]))
        if st["hit"] is not None:
            line += ", outcome hit %.0f%% (%d checked)" \
                % (100 * st["hit"], st["outcomes"])
        if st["miscalibrated"]:
            line += (" — MISCALIBRATED: its rejected "
                     "suggestions score as high as its "
                     "accepted ones; its gate scores "
                     "overstate quality")
        lines.append(line)
    return "\n".join(lines)


def brief(conn):
    ensure(conn)
    with conn.cursor() as cur:
        cur.execute(
            "SELECT id, item_key, seat, exec_decision, "
            "suggested_at::date FROM "
            "atlas.board_suggestions WHERE exec_decision "
            "!= 'pending' AND outcome = 'unknown' "
            "ORDER BY suggested_at LIMIT 10")
        loops = cur.fetchall()
        cur.execute(
            "SELECT count(*) FROM "
            "atlas.board_suggestions WHERE exec_decision "
            "= 'pending'")
        pending = cur.fetchone()[0]
        cur.execute(
            "SELECT seat, item_key, outcome, "
            "outcome_notes FROM atlas.board_suggestions "
            "WHERE outcome != 'unknown' ORDER BY "
            "outcome_at DESC LIMIT 5")
        recent = cur.fetchall()
    lines = ["# Board learning brief", "",
             scorecard(conn), "",
             "## Open loops (decided, never "
             "outcome-checked): %d shown" % len(loops),
             "Suggestions still awaiting an executive "
             "decision: %d" % pending]
    for r in loops:
        lines.append("- #%d [%s on %s, %s] suggested %s"
                     % (r[0], r[2], r[1], r[3], r[4]))
    lines.append("")
    lines.append("## Most recent outcomes")
    if recent:
        for r in recent:
            lines.append("- %s on %s: %s — %s"
                         % (r[0], r[1], r[2], r[3] or ""))
    else:
        lines.append("(no outcomes recorded yet — the "
                     "board has not closed a single loop)")
    with conn.cursor() as cur:
        cur.execute(
            "SELECT status, count(*) FROM "
            "atlas.board_ideas GROUP BY 1")
        idea_counts = dict(cur.fetchall())
        cur.execute(
            "SELECT front, count(*) FROM "
            "atlas.board_research_orders WHERE status = "
            "'open' AND front IS NOT NULL GROUP BY 1")
        open_by_front = dict(cur.fetchall())
        cur.execute(
            "SELECT count(*) FROM "
            "atlas.board_research_orders WHERE status = "
            "'open' AND idea_id IS NOT NULL")
        open_for_ideas = cur.fetchone()[0]
    lines.append("")
    lines.append("## Idea table (below the 95% line)")
    lines.append("Ideas by status: %s. Open research "
                 "orders on ideas: %d."
                 % (", ".join("%s %d" % kv for kv
                              in sorted(idea_counts.items()))
                    or "none", open_for_ideas))
    lines.append("")
    lines.append("## Improvement fronts — coverage")
    for front, desc in IMPROVEMENT_FRONTS.items():
        n = open_by_front.get(front, 0)
        lines.append("- %s: %d open order(s)%s — %s"
                     % (front, n,
                        " — GAP: nothing is researching "
                        "this front" if n == 0 else "",
                        desc))
    lines.append("")
    text = "\n".join(lines)
    with open(BRIEF_PATH, "w") as f:
        f.write(text)
    return text


def selftest(conn):
    failures = []

    def check(cond, label):
        print(("PASS  " if cond else "FAIL  ") + label)
        if not cond:
            failures.append(label)

    ensure(conn)
    ids = []
    specs = [("accepted", "worked", 0.97),
             ("accepted", "failed", 0.95),
             ("rejected", "unknown", 0.99),
             ("modified", "mixed", 0.96)]
    for i, (dec, out, score) in enumerate(specs):
        sid = log_suggestion(
            conn, "task:selftest-%d" % i, "SELFTEST",
            "synthetic suggestion %d" % i,
            gate_score=score, session_ref="selftest")
        ids.append(sid)
        decide(conn, sid, dec, "selftest")
        if out != "unknown":
            set_outcome(conn, sid, out, "selftest")
    rows = [r for r in fetch_all(conn)
            if r["seat"] == "SELFTEST"]
    st = seat_stats(rows)
    check(st["n"] == 4 and st["decided"] == 4,
          "ledger records the full life cycle")
    check(abs(st["acceptance"] - (2 + 0.5) / 4) < 1e-9,
          "acceptance math: (2 acc + 0.5 mod) / 4 = %.3f"
          % st["acceptance"])
    check(abs(st["hit"] - (1 + 0.5) / 3) < 1e-9,
          "outcome hit math: (1 worked + 0.5 mixed) / 3 "
          "= %.3f" % st["hit"])
    check(st["miscalibrated"],
          "calibration: rejected 0.99 >= accepted 0.96 "
          "flags miscalibrated")
    calm = seat_stats([
        {"exec_decision": "accepted", "outcome": "worked",
         "gate_score": 0.95},
        {"exec_decision": "rejected", "outcome": "unknown",
         "gate_score": 0.60}])
    check(not calm["miscalibrated"],
          "calibration: a seat whose rejects score low "
          "is calibrated")
    refused = False
    try:
        log_suggestion(conn, "task:selftest-low",
                       "SELFTEST", "below the line",
                       gate_score=0.90)
    except Exception:
        conn.rollback()
        refused = True
    check(refused,
          "R37: a 0.90 release cannot be written to the "
          "ledger (schema-enforced)")
    iid = log_idea(conn, "SELFTEST", "synthetic board "
                   "idea", 0.80, front="token-burn")
    check(iid > 0,
          "R37: a 0.80 thought lands in the idea table")
    over = False
    try:
        log_idea(conn, "SELFTEST", "too sure", 0.97)
    except ValueError:
        over = True
    check(over,
          "R37: the idea table refuses release-grade "
          "certainty")
    orig = file_research_task
    globals()["file_research_task"] = \
        lambda idea_id, front, q: "task:board-research:stub"
    try:
        oid, key = research_order(
            conn, "synthetic research question",
            idea_id=iid, front="token-burn")
    finally:
        globals()["file_research_task"] = orig
    check(oid > 0 and key.endswith("stub"),
          "R37: a research order records against the "
          "idea")
    sid2, msg = promote_idea(conn, iid, 0.93)
    check(sid2 is None and "below" in msg,
          "R37: promotion at 0.93 is refused")
    sid2, msg = promote_idea(conn, iid, 0.96)
    check(sid2 is not None,
          "R37: promotion at 0.96 releases (%s)" % msg)
    with conn.cursor() as cur:
        cur.execute(
            "DELETE FROM atlas.board_research_orders "
            "WHERE idea_id = %s", (iid,))
        cur.execute(
            "DELETE FROM atlas.board_ideas WHERE "
            "seat = 'SELFTEST'")
        cur.execute(
            "DELETE FROM atlas.board_suggestions WHERE "
            "seat = 'SELFTEST'")
    conn.commit()
    if failures:
        print("SELFTEST FAILED: %d" % len(failures))
        return 1
    print("SELFTEST OK")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "brief"
    conn = pg()
    try:
        if cmd == "log":
            # log --item K --seat S --score 0.9
            #     [--session R] "text..."
            item = argv[argv.index("--item") + 1]
            seat = argv[argv.index("--seat") + 1]
            score = None
            if "--score" in argv:
                score = float(argv[argv.index("--score") + 1])
            session = None
            if "--session" in argv:
                session = argv[argv.index("--session") + 1]
            text = argv[-1]
            sid = log_suggestion(conn, item, seat, text,
                                 score, session)
            print("suggestion #%d logged (%s on %s)"
                  % (sid, seat, item))
            return 0
        if cmd == "decide":
            notes = ""
            if "--notes" in argv:
                notes = " ".join(
                    argv[argv.index("--notes") + 1:])
            ok = decide(conn, int(argv[2]), argv[3], notes)
            print("decided" if ok else "no such suggestion")
            return 0 if ok else 1
        if cmd == "outcome":
            notes = ""
            if "--notes" in argv:
                notes = " ".join(
                    argv[argv.index("--notes") + 1:])
            ok = set_outcome(conn, int(argv[2]), argv[3],
                             notes)
            print("outcome recorded" if ok
                  else "no such suggestion")
            return 0 if ok else 1
        if cmd == "idea":
            # idea --seat S --certainty 0.80 [--item K]
            #      [--front F] "text"
            seat = argv[argv.index("--seat") + 1]
            cert = float(argv[argv.index("--certainty") + 1])
            item = front = None
            if "--item" in argv:
                item = argv[argv.index("--item") + 1]
            if "--front" in argv:
                front = argv[argv.index("--front") + 1]
            try:
                iid = log_idea(conn, seat, argv[-1], cert,
                               item, front)
            except ValueError as e:
                print(str(e))
                return 1
            print("idea #%d recorded (certainty %.4f — "
                  "below the line, researching)"
                  % (iid, cert))
            return 0
        if cmd == "research":
            # research "question" [--idea N] [--front F]
            idea_id = front = None
            if "--idea" in argv:
                idea_id = int(argv[argv.index("--idea") + 1])
            if "--front" in argv:
                front = argv[argv.index("--front") + 1]
            oid, key = research_order(conn, argv[2],
                                      idea_id, front)
            print("research order #%d filed as %s"
                  % (oid, key))
            return 0
        if cmd == "promote":
            score = float(argv[argv.index("--score") + 1])
            session = None
            if "--session" in argv:
                session = argv[argv.index("--session") + 1]
            sid, msg = promote_idea(conn, int(argv[2]),
                                    score, session)
            print(msg)
            return 0 if sid else 1
        if cmd == "kill":
            why = ""
            if "--why" in argv:
                why = " ".join(argv[argv.index("--why") + 1:])
            ok = kill_idea(conn, int(argv[2]), why)
            print("idea killed (recorded)" if ok
                  else "no researching idea with that id")
            return 0 if ok else 1
        if cmd == "ideas":
            ensure(conn)
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT id, seat, certainty, status, "
                    "front, left(idea, 70) FROM "
                    "atlas.board_ideas ORDER BY id DESC "
                    "LIMIT 20")
                for r in cur.fetchall():
                    print("#%-4d %-14s %.2f %-11s %-20s %s"
                          % r)
            return 0
        if cmd == "orders":
            ensure(conn)
            with conn.cursor() as cur:
                cur.execute(
                    "SELECT id, idea_id, front, task_key, "
                    "left(question, 60) FROM "
                    "atlas.board_research_orders WHERE "
                    "status = 'open' ORDER BY id")
                rows = cur.fetchall()
            if not rows:
                print("no open research orders")
            for r in rows:
                print("#%-4d idea=%s front=%s %s — %s" % r)
            return 0
        if cmd == "fronts":
            for f, d in IMPROVEMENT_FRONTS.items():
                print("%s — %s" % (f, d))
            return 0
        if cmd == "scorecard":
            print(scorecard(conn))
            return 0
        if cmd == "brief":
            print(brief(conn))
            return 0
        if cmd == "selftest":
            return selftest(conn)
        print("usage: board_learning.py "
              "[log|decide|outcome|scorecard|brief|idea|"
              "research|promote|kill|ideas|orders|fronts|"
              "selftest]")
        return 2
