DDL = """
CREATE TABLE IF NOT EXISTS atlas.allm_workspace_registry (
    slug        text PRIMARY KEY,
    kind        text NOT NULL CHECK (kind IN
                    ('domain','intake','quarantine')),
    owner       text NOT NULL,
    category    text,
    purpose     text NOT NULL,
    ingest_rule text NOT NULL,
    status      text NOT NULL CHECK (status IN ('live','determined')),
    note        text
);
CREATE TABLE IF NOT EXISTS atlas.planning_workspaces (
    slug        text PRIMARY KEY,
    subject     text NOT NULL,
    status      text NOT NULL DEFAULT 'active'
                CHECK (status IN
                    ('active','graduated','abandoned')),
    note        text,
    created_at  timestamptz NOT NULL DEFAULT now()
);
"""


def pg():
    # Mirrors atlas.py's connection identity: the atlas schema is
    # owned by the postgres role and atlas.py writes as postgres.
    return psycopg2.connect(dbname=DBNAME, host="localhost",
                            user="postgres", password="postgres")


def live_workspaces():
    """Ground truth from AnythingLLM's own DB, read-only."""
    db = sqlite3.connect("file:%s?mode=ro" % ALLM_DB, uri=True)
    try:
        rows = db.execute(
            "SELECT w.slug, count(wd.id) FROM workspaces w "
            "LEFT JOIN workspace_documents wd "
            "ON wd.workspaceId = w.id GROUP BY w.slug"
        ).fetchall()
    finally:
        db.close()
    return dict(rows)


def seed(conn):
    with conn.cursor() as cur:
        cur.execute(DDL)
        for row in REGISTRY:
            cur.execute(
                """
                INSERT INTO atlas.allm_workspace_registry
                    (slug, kind, owner, category, purpose,
                     ingest_rule, status, note)
                VALUES (%s, %s, %s, %s, %s, %s, %s, %s)
                ON CONFLICT (slug) DO UPDATE SET
                    kind = EXCLUDED.kind, owner = EXCLUDED.owner,
                    category = EXCLUDED.category,
                    purpose = EXCLUDED.purpose,
                    ingest_rule = EXCLUDED.ingest_rule,
                    status = EXCLUDED.status, note = EXCLUDED.note
                """,
                row,
            )
        slugs = [r[0] for r in REGISTRY]
        cur.execute(
            "DELETE FROM atlas.allm_workspace_registry "
            "WHERE slug <> ALL(%s)",
            (slugs,),
        )
        # Sync the Atlas allm:* nodes: a registered workspace's node
        # carries its purpose and a truthful status.
        for row in REGISTRY:
            status = "active" if row[6] == "live" else "planned"
            cur.execute(
                "UPDATE atlas.nodes SET summary = %s, status = %s, "
                "updated_at = now() WHERE node_type = 'allm_workspace' "
                "AND (node_key = %s OR node_key = %s)",
                (row[4], status, "allm:" + row[0],
                 node_key_for(row[0])),
            )
    conn.commit()
    return len(REGISTRY)


def registry_rows(conn):
    with conn.cursor() as cur:
        cur.execute(
            "SELECT slug, kind, owner, category, purpose, "
            "ingest_rule, status FROM atlas.allm_workspace_registry "
            "ORDER BY slug"
        )
        return cur.fetchall()


def _norm(s):
    return "".join(c for c in s.lower() if c.isalnum())


def determine(conn, subject, category=None):
    """Apply Brian's rules to a subject. Returns a verdict dict."""
    rows = registry_rows(conn)
    subj = _norm(subject)
    # R8 first: a rejected build routes to the negative registry,
    # never to a builds body — checked before any owner match.
    for key, entry in NOT_BUILDING.items():
        if key in subj:
            return {"verdict": "not_building",
                    "workspace": "builds-we-are-not-building",
                    "tag": entry["tag"],
                    "why": entry["why"]}
    # R18: a dead business routes to the dead-mlms registry
    # under its tag — never to an active business body.
    for key, entry in DEAD_MLMS.items():
        if key in subj:
            return {"verdict": "dead_business",
                    "workspace": "dead-mlms",
                    "tag": entry["tag"],
                    "why": entry["why"]}
    # R23: a disliked thing routes to the dislike registry
    # under its tag — it never gets a body of its own.
    for key, entry in DISLIKES.items():
        if key in subj:
            return {"verdict": "disliked",
                    "workspace": "things-brian-doesnt-like",
                    "tag": entry["tag"],
                    "why": entry["why"]}
    # R30: an ACTIVE plan owns its subject's idea-dump
    # material while Brian is planning it — checked after
    # the negative registries, before settled owners.
    for pslug, psubj, _st in planning_rows(conn):
        pn = _norm(psubj)
        if pn and (pn == subj
                   or (len(pn) >= 4 and pn in subj)
                   or (len(subj) >= 4 and subj in pn)):
            return {"verdict": "planning", "workspace": pslug,
                    "status": "active",
                    "why": "An active plan owns this subject "
                           "while it is being planned (R30): "
                           "idea-dump material goes to the "
                           "planning body."}
    # R1/R3: the subject's own workspace. An EXACT slug match
    # outranks every owner-text match, globally — otherwise a
    # subject named inside another workspace's owner string
    # (e.g. 'campaignsdesk' inside AegeanVedaFlow's owner)
    # hijacks the route. Two passes, exact first.
    for r in rows:
        if _norm(r[0]) == subj:
            return {"verdict": "existing", "workspace": r[0],
                    "status": r[6],
                    "why": "Owner match: the workspace owned by/for "
                           "this subject."}
    for r in rows:
        if subj in _norm(r[2]) or _norm(r[2]).startswith(subj):
            return {"verdict": "existing", "workspace": r[0],
                    "status": r[6],
                    "why": "Owner match: the workspace owned by/for "
                           "this subject."}
    # R2: category siblings exist but NEVER absorb (separation rule).
    if category:
        siblings = [r[0] for r in rows
                    if (r[3] or "").lower() == category.lower()]
        if siblings:
            return {"verdict": "create_new",
                    "proposed_slug": subject.lower().replace(" ", "-"),
                    "rejected_absorbers": siblings,
                    "why": "Separation is per business, not per "
                           "category (Brian, 2026-10-22): %s share "
                           "the %s category and do NOT absorb a "
                           "distinct business."
                           % (", ".join(siblings), category)}
    # R5: no owner determined yet -> intake.
    return {"verdict": "intake", "workspace": "unsorted",
            "why": "No owning workspace determined. Material waits "
                   "in unsorted until an owner is named (R5)."}


