def cmd_plan(conn, argv):
    """plan start <subject> | plan list | plan graduate <slug>
    | plan abandon <slug> [why...]"""
    if len(argv) < 3:
        print("usage: plan start <subject> | plan list | "
              "plan graduate <slug> | plan abandon <slug>")
        return 2
    action = argv[2]
    seed(conn)
    if action == "list":
        with conn.cursor() as cur:
            cur.execute(
                "SELECT slug, subject, status FROM "
                "atlas.planning_workspaces ORDER BY slug")
            rows = cur.fetchall()
        if not rows:
            print("no planning bodies yet")
        for slug, subj, st in rows:
            print("%-32s %-10s %s" % (slug, st, subj))
        return 0
    if action == "start":
        if len(argv) < 4:
            print("usage: plan start <subject>")
            return 2
        subject = " ".join(argv[3:])
        slug = plan_slug(subject)
        key = _allm_key()
        if not key:
            print("no ANYTHINGLLM_API_KEY in .env — cannot "
                  "create the workspace")
            return 1
        payload = _allm_post("/api/v1/workspace/new",
                             {"name": slug}, key)
        if not payload.get("workspace"):
            print("AnythingLLM did not create %s: %s"
                  % (slug, payload.get("message", payload)))
            return 1
        purpose = ("Planning body (R30): the idea dump for "
                   "Brian's plan — %s. Raw ideas, questions, "
                   "options, and decisions-in-the-making "
                   "while he plans it." % subject)
        with conn.cursor() as cur:
            cur.execute(
                "INSERT INTO atlas.planning_workspaces "
                "(slug, subject, status, note) VALUES "
                "(%s, %s, 'active', %s) ON CONFLICT (slug) "
                "DO UPDATE SET status = 'active', "
                "subject = EXCLUDED.subject",
                (slug, subject,
                 "Started by Brian's R30 rule, 2026-10-23."))
            cur.execute(
                "INSERT INTO atlas.nodes (node_key, node_type, "
                "name, status, summary, updated_at) SELECT "
                "%s, 'allm_workspace', %s, 'active', %s, now() "
                "WHERE NOT EXISTS (SELECT 1 FROM atlas.nodes "
                "WHERE node_key = %s)",
                (node_key_for(slug), slug, purpose,
                 node_key_for(slug)))
            cur.execute(
                "INSERT INTO atlas.edges (from_node, to_node, "
                "edge_type, notes) SELECT 'segment:core', %s, "
                "'contains', 'R30: planning bodies sit in "
                "core.' WHERE NOT EXISTS (SELECT 1 FROM "
                "atlas.edges WHERE from_node = 'segment:core' "
                "AND to_node = %s AND edge_type = 'contains')",
                (node_key_for(slug), node_key_for(slug)))
        conn.commit()
        _upload_embed(slug, "planning-template.md",
                      PLANNING_TEMPLATE.replace("SUBJECT",
                                                subject), key)
        print("planning body live: %s (subject: %s)"
              % (slug, subject))
        return 0
    if action in ("graduate", "abandon"):
        if len(argv) < 4:
            print("usage: plan %s <slug>" % action)
            return 2
        slug = argv[3]
        status = "graduated" if action == "graduate" \
            else "abandoned"
        with conn.cursor() as cur:
            cur.execute(
                "UPDATE atlas.planning_workspaces SET "
                "status = %s WHERE slug = %s",
                (status, slug))
            hit = cur.rowcount
        conn.commit()
        print("%s -> %s" % (slug, status) if hit
              else "no such planning body: %s" % slug)
        return 0 if hit else 1
    print("unknown plan action: %s" % action)
    return 2


