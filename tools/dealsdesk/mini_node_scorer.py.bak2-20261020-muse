#!/usr/bin/env python3
"""mini_node_scorer.py — rank used 1L DDR4 mini-PCs as Colibri fleet nodes.

PURPOSE: Score and rank used 1-liter business mini-PC listings (ThinkCentre
         Tiny, EliteDesk/ProDesk Mini, OptiPlex Micro class) against Brian's
         2026-10-20 sourcing directive: cheap DDR4 nodes that run the
         DeepSeek V4 Flash REAP 150B under Colibri as background/contributing
         inference lanes. Raw speed is NOT the goal — running it at all is.

WHY:     Colibri's floor for the REAP is 16 GB RAM with experts streamed
         from NVMe, so a $199-class DDR4 box qualifies — but only if the
         exact machine is right. The traps are silent: Celeron/Pentium CPUs
         with no AVX2, soldered RAM, single SO-DIMM slots, M.2 slots wired
         x2, and no path past gigabit networking. And under the 2026 RAM
         price regime the RAM already inside the deal can be worth more
         than the box, so installed RAM is valued in dollars, not just GB.
         Companion to rack_server_scorer.py (which encodes the separate
         2026-10-08 rack directive; its 64 GB floor does NOT apply here).

CALLED BY: DealsDesk agent when the DDR4 fleet hunt returns candidates;
         manually for one-off listing checks. This module ranks only; it
         never purchases anything.

NOTES:   - Prices/valuations come from ram_price_reference.json in this
           directory (verified 2026-10-20) when present; embedded fallbacks
           match that file. Re-verify prices before relying on them.
         - Upgradeability is scored by Brian's rule: its weight scales with
           the moving price of RAM. factor = historical_norm_$/GB divided
           by current used $/GB, clamped 0..1 — expensive RAM makes empty
           slots worth less, cheap RAM makes them worth more.
    - CANONICAL SOURCE: successbrian-os/tools/dealsdesk/mini_node_scorer.py
"""

import argparse
import json
import logging
import os
import sys

logging.basicConfig(level=logging.INFO, format="%(message)s")
LOG = logging.getLogger("mini_node_scorer")

# --- Directive constants (Brian 2026-10-20) -----------------------------------
PRICE_CEILING_USD = 199.0     # delivered (price + shipping), hard gate
COLIBRI_RAM_FLOOR_GB = 16     # REAP 150B starts here per the Colibri catalog
STORAGE_FLOOR_GB = 256        # Brian 2026-10-20: "128GB drives are too small"
                              # (the REAP build alone is 85GB before OS/library)

# CPU strings that mean "no AVX2, no deal" (the cheap-bin traps).
CPU_BLOCKLIST = ("celeron", "pentium", "j4125", "j4105", "j4025", "j6412",
                 "n5095", "n5105", "n3450", "n3350")
# CPU strings known to carry AVX2.
CPU_AVX2_KNOWN = ("core i3", "core i5", "core i7", "core i9", "ryzen",
                  "n100", "n95", "n97", "core 3", "core 5", "core 7")

# Fallbacks matching ram_price_reference.json (verified 2026-10-20).
_FALLBACK_RAM_VALUE = {8: 25, 16: 55, 32: 130, 64: 365}   # used-market mids
_FALLBACK_GB_PRICE = 5.7        # current used DDR4 $/GB
_FALLBACK_NORM_GB_PRICE = 2.0   # 2023-24 norm $/GB


def _load_price_reference():
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "ram_price_reference.json")
    try:
        with open(path) as f:
            ref = json.load(f)
        val = ref["valuation_for_scorers"]
        ram_value = {int(k): v for k, v in
                     val["ddr4_installed_ram_value_usd"].items()}
        return (ram_value, float(val["ddr4_used_gb_price_usd"]),
                float(val["historical_norm_gb_price_usd"]))
    except Exception:
        return _FALLBACK_RAM_VALUE, _FALLBACK_GB_PRICE, _FALLBACK_NORM_GB_PRICE


RAM_VALUE_USD, GB_PRICE_USD, NORM_GB_PRICE_USD = _load_price_reference()


def ram_value_usd(ram_gb):
    """Used-market value of the installed DDR4, nearest tier at/below."""
    tiers = sorted(RAM_VALUE_USD)
    best = 0
    for t in tiers:
        if ram_gb >= t:
            best = RAM_VALUE_USD[t]
    return best


def upgradeability_factor():
    """Brian's rule: expensive RAM shrinks the value of upgradeability."""
    if GB_PRICE_USD <= 0:
        return 1.0
    return max(0.0, min(1.0, NORM_GB_PRICE_USD / GB_PRICE_USD))


def avx2_ok(c):
    """Returns (ok, known). Explicit avx2 field wins; then blocklist/known."""
    if c.get("avx2") is not None:
        return bool(c["avx2"]), True
    cpu = str(c.get("cpu", "")).lower()
    if any(b in cpu for b in CPU_BLOCKLIST):
        return False, True
    if any(k in cpu for k in CPU_AVX2_KNOWN):
        return True, True
    return False, False


# Reference target for --bar: the shape of deal the directive hunts.
REFERENCE_BAR = {
    "name": "ThinkCentre M920q i5-8500T 32GB (reference target)",
    "price": 179.0, "shipping": 12.0,
    "cpu": "Intel Core i5-8500T", "cores": 6,
    "ram_gb": 32, "sodimm_slots": 2, "soldered": False, "ram_ceiling_gb": 64,
    "nvme_slots": 1, "nvme_lanes": 4, "storage_gb": 256, "sata_bay": False,
    "ethernet_gbe": 1.0, "wifi_slot": True, "pcie_riser": True,
    "usb32_gen2": True, "power_adapter": True,
}


def score_candidate(c):
    """Score one candidate dict. Returns the dict with scoring fields added."""
    price = float(c.get("price", 0) or 0)
    shipping = float(c.get("shipping", 0) or 0)
    delivered = price + shipping
    ram_gb = int(c.get("ram_gb", 0) or 0)
    cores = int(c.get("cores", 0) or 0)
    ceiling = int(c.get("ram_ceiling_gb", 0) or 0)
    notes = []
    rejects = []

    c["delivered_usd"] = round(delivered, 2)
    c["ram_value_usd"] = ram_value_usd(ram_gb)
    c["net_cost_after_ram_credit_usd"] = round(delivered - c["ram_value_usd"], 2)
    c["upgradeability_factor"] = round(upgradeability_factor(), 2)

    # --- Hard gates (fail any = out) -----------------------------------------
    if delivered > PRICE_CEILING_USD:
        rejects.append("delivered $%.2f over the $%d ceiling"
                       % (delivered, PRICE_CEILING_USD))
    ok, known = avx2_ok(c)
    if not ok:
        rejects.append("no AVX2 (Colibri needs it)"
                       if known else "CPU unknown — AVX2 unverified")
    if c.get("soldered"):
        rejects.append("RAM soldered")
    if int(c.get("sodimm_slots", 0) or 0) < 2:
        rejects.append("fewer than 2 SO-DIMM slots")
    if ceiling < 32:
        rejects.append("RAM ceiling %dGB — no path to 32GB+" % ceiling)
    if int(c.get("nvme_slots", 0) or 0) < 1:
        rejects.append("no M.2 NVMe slot")
    storage_gb = int(c.get("storage_gb", 0) or 0)
    if storage_gb and storage_gb < STORAGE_FLOOR_GB:
        rejects.append("drive too small: %dGB (floor %dGB — the REAP build "
                       "alone is 85GB before OS and library)"
                       % (storage_gb, STORAGE_FLOOR_GB))
    if not c.get("ethernet_gbe"):
        rejects.append("no Ethernet")
    if cores and cores < 4:
        rejects.append("fewer than 4 cores (streaming is CPU-bound)")

    if rejects:
        c["score"] = -1.0
        c["verdict"] = "REJECT"
        c["notes"] = rejects
        return c

    # --- Scored factors, Brian's priority order ------------------------------
    score = 40.0

    # 1. Installed RAM (the deal's real payload under 2026 prices).
    if ram_gb >= 64:
        score += 30
    elif ram_gb >= 32:
        score += 22
    elif ram_gb >= COLIBRI_RAM_FLOOR_GB:
        score += 10
        notes.append("16GB: runs the REAP today at the Colibri floor; "
                     "cache grows only if RAM gets cheaper")
    else:
        notes.append("below the 16GB Colibri floor as shipped — "
                     "needs a RAM add before it contributes")

    # 2. NVMe combo: full-x4 wiring beats slot count.
    lanes = c.get("nvme_lanes")
    if lanes == 4:
        score += 15
    elif lanes == 2:
        score += 5
        notes.append("NVMe wired x2 — streaming tier runs at half width")
    else:
        notes.append("NVMe lane width unverified — confirm before buying")
    if int(c.get("nvme_slots", 0) or 0) >= 2:
        score += 5
    if storage_gb >= 512:
        score += 5
        notes.append("512GB+: room for the REAP plus a local model library")
    elif storage_gb == 0:
        notes.append("storage size unverified — floor is %dGB"
                     % STORAGE_FLOOR_GB)
    if c.get("sata_bay"):
        score += 5
        notes.append("2.5in bay: OS/library overflow, NVMe stays pure "
                     "for expert streaming")

    # 3. Network upgrade paths (fabric future).
    if c.get("pcie_riser"):
        score += 15
        notes.append("PCIe riser: a real 10GbE NIC fits — best fabric path")
    if c.get("wifi_slot"):
        score += 8
        notes.append("Wi-Fi M.2 slot can become a 2.5GbE port "
                     "(dual wired fabric)")
    if float(c.get("ethernet_gbe", 0) or 0) >= 2.5:
        score += 8
    if c.get("usb32_gen2"):
        score += 4
        notes.append("USB 3.2 Gen2 present: USB-10GbE fallback path")

    # 4. Fleet manners.
    if cores >= 6:
        score += 8
    elif cores >= 4:
        score += 4
    if c.get("power_adapter") is False:
        score -= 5
        notes.append("no power adapter in the deal — replacement eats "
                     "the margin")
    if c.get("wol") or c.get("auto_power_on"):
        score += 3

    # 5. Upgradeability headroom, weighted by the moving RAM price.
    headroom = max(0, ceiling - ram_gb)
    if headroom > 0:
        bonus = 10.0 * upgradeability_factor() * (headroom / 48.0)
        score += bonus
        notes.append("headroom %dGB scored at factor %.2f "
                     "(used DDR4 $%.2f/GB vs $%.2f norm)"
                     % (headroom, upgradeability_factor(),
                        GB_PRICE_USD, NORM_GB_PRICE_USD))
    if ceiling == 32:
        notes.append("32GB-capped model — fine today, no cache-rich endgame")

    c["score"] = round(score, 1)
    c["verdict"] = ("FLEET-NODE-STRONG" if score >= 75 else
                    "FLEET-NODE" if score >= 55 else "MARGINAL")
    c["notes"] = notes
    return c


def rank(candidates):
    scored = [score_candidate(dict(c)) for c in candidates]
    scored.sort(key=lambda c: c["score"], reverse=True)
    return scored


def main(argv=None):
    ap = argparse.ArgumentParser(
        description="Rank used 1L DDR4 mini-PCs as Colibri fleet nodes.")
    ap.add_argument("--json", help="JSON file with a list of candidate dicts")
    ap.add_argument("--bar", action="store_true",
                    help="Score the reference target and exit")
    args = ap.parse_args(argv)

    if args.bar:
        print(json.dumps(score_candidate(dict(REFERENCE_BAR)), indent=2))
        return 0

    if not args.json:
        ap.error("--json <file> or --bar is required")

    with open(args.json) as f:
        candidates = json.load(f)
    ranked = rank(candidates)
    for c in ranked:
        LOG.info("%-42s score=%6.1f delivered=$%s ram_value=$%s verdict=%s",
                 c.get("name", "?")[:42], c["score"], c["delivered_usd"],
                 c["ram_value_usd"], c["verdict"])
    print(json.dumps(ranked, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
