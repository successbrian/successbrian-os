    with conn.cursor() as cur:
        cur.execute(
            "SELECT count(*) FROM atlas.nodes "
            "WHERE node_type = 'allm_workspace' "
            "AND summary IS NOT NULL AND summary <> ''")
        filled = cur.fetchone()[0]
    check(filled >= 15,
          "Atlas allm_workspace nodes now carry purposes "
          "(%d filled)" % filled)

    if failures:
        print("SELFTEST FAILED: %d check(s)" % len(failures))
        return 1
    print("SELFTEST OK")
    return 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "list"
    conn = pg()
    try:
        if cmd == "seed":
            print("seeded atlas.allm_workspace_registry: %d rows"
                  % seed(conn))
            return 0
        if cmd == "list":
            cmd_list(conn)
            return 0
        if cmd == "determine":
            if len(argv) < 3:
                print("usage: allm_workspaces.py determine <subject> "
                      "[--category C]")
                return 2
            category = None
            if "--category" in argv:
                category = argv[argv.index("--category") + 1]
            d = determine(conn, argv[2], category)
            print("%s -> %s" % (argv[2], d["verdict"]))
            for k in ("workspace", "tag", "proposed_slug", "status",
                      "rejected_absorbers", "why"):
                if k in d:
                    print("    %s: %s" % (k, d[k]))
            return 0
        if cmd == "audit":
            for line in audit(conn):
                print(line)
            return 0
        if cmd == "placement":
            cmd_placement(conn)
            return 0
        if cmd == "integrate":
            return cmd_integrate(conn)
        if cmd == "plan":
            return cmd_plan(conn, argv)
        if cmd == "selftest":
            return selftest(conn)
        print("usage: allm_workspaces.py "
              "[list|determine <subject>|audit|placement|"
              "seed|integrate|plan <action>|selftest]")
        return 2
    finally:
        conn.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
