        return "allm:mountain-north"
    return "allm:" + slug


def plan_edges():
    """R27: the full wiring plan, computed purely from the
    coded record (SEGMENTS + RELATIONSHIPS). Returns a list
    of (from_node, to_node, edge_type, note)."""
    edges = []
    for name, seg in SEGMENTS.items():
        hub = "segment:" + name
        edges.append(
            ("allm:successbrian-os", hub, "contains",
             "R27: SuccessBrian OS contains the %s segment "
             "— the core's placement of bodies (R14)." % name))
        for slug in seg["bodies"]:
            edges.append(
                (hub, node_key_for(slug), "contains",
                 "R27: %s sits in the %s segment (R14 "
                 "placement)." % (slug, name)))
    for frm, to, etype, note in RELATIONSHIPS:
        edges.append((node_key_for(frm), node_key_for(to),
                      etype, note))
    return edges


def _ensure_hubs(conn):
    with conn.cursor() as cur:
        for name, seg in SEGMENTS.items():
            key = "segment:" + name
            cur.execute(
                "INSERT INTO atlas.nodes (node_key, node_type, "
                "name, status, summary, updated_at) "
                "SELECT %s, 'allm_segment', %s, 'active', %s, "
                "now() WHERE NOT EXISTS (SELECT 1 FROM "
                "atlas.nodes WHERE node_key = %s)",
                (key, "Segment: " + name, seg["character"], key))
            cur.execute(
                "UPDATE atlas.nodes SET summary = %s, "
                "status = 'active', updated_at = now() "
                "WHERE node_key = %s",
                (seg["character"], key))
    conn.commit()
    return len(SEGMENTS)


def _apply_edges(conn, edges):
    inserted = 0
    with conn.cursor() as cur:
        for frm, to, etype, note in edges:
            cur.execute(
                "INSERT INTO atlas.edges (from_node, to_node, "
                "edge_type, notes) SELECT %s, %s, %s, %s "
                "WHERE NOT EXISTS (SELECT 1 FROM atlas.edges "
                "WHERE from_node = %s AND to_node = %s AND "
                "edge_type = %s)",
                (frm, to, etype, note, frm, to, etype))
            inserted += cur.rowcount
    conn.commit()
    return inserted


